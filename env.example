# Copy to .env only for local development. Never commit .env.
PORT=3000
NODE_ENV=development
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional local/persistent-disk account storage fallback.
# Local development already uses .chronicle-data automatically.
# CHRONICLE_DATA_DIR=/var/data

# Optional comma-separated developer accounts. Keep this in environment variables, not source code.
# CHRONICLE_DEVELOPER_EMAILS=developer@example.com
