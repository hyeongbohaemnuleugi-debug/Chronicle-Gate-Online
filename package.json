{
  "name": "chronicle-gate-online",
  "version": "9.0.0",
  "private": true,
  "type": "module",
  "description": "1-4 player server-authoritative online TRPG with free-form scene actions, fail-forward checks, shared-world split-party play, persistent accounts, and nine chronicles",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/qa.mjs",
    "test": "node --test tests-release/*.test.mjs",
    "verify": "npm run check && npm test",
    "test:legacy": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "socket.io": "4.8.3",
    "three": "0.185.1"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
