:root{--bg:#0b070d;--panel:rgba(25,14,28,.79);--line:rgba(255,255,255,.1);--text:#fff7ff;--muted:#b8a9bc;--pink:#ff2f78;--hot:#ff165d;--violet:#9f42ff;--cyan:#4be7ff;--gold:#ffd56b;--shadow:0 24px 70px rgba(0,0,0,.45)}
*{box-sizing:border-box}html{min-height:100%;background:var(--bg)}body{margin:0;min-height:100vh;color:var(--text);font-family:"Noto Sans KR",sans-serif;background:radial-gradient(circle at 50% -20%,#32142e 0,#130b17 36%,#09070b 75%);overflow-x:hidden}button,input{font:inherit}button{cursor:pointer}.hidden{display:none!important}.bg-grid{position:fixed;inset:0;pointer-events:none;opacity:.18;background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);background-size:44px 44px;mask-image:linear-gradient(to bottom,#000,transparent 82%)}.ambient{position:fixed;width:440px;height:440px;border-radius:50%;filter:blur(110px);opacity:.16;pointer-events:none}.ambient-a{background:var(--pink);left:-180px;top:18%}.ambient-b{background:var(--violet);right:-200px;bottom:0}.topbar{height:82px;padding:0 clamp(18px,4vw,64px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:rgba(8,5,10,.74);backdrop-filter:blur(18px);position:sticky;top:0;z-index:20}.brand{display:flex;align-items:center;gap:12px;color:inherit;text-decoration:none}.brand-mark{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;font-family:"Black Han Sans";font-size:26px;background:linear-gradient(145deg,var(--pink),var(--violet));box-shadow:0 0 28px rgba(255,47,120,.35)}.brand strong,.brand small{display:block}.brand strong{font-weight:900;letter-spacing:.08em}.brand small{font-size:10px;letter-spacing:.2em;color:var(--muted);margin-top:1px}.top-actions{display:flex;align-items:center;gap:10px}.status-pill{display:flex;align-items:center;gap:8px;padding:9px 12px;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:12px}.status-pill i{width:8px;height:8px;border-radius:50%;background:#ffb02e;box-shadow:0 0 10px currentColor}.status-pill.online i{background:#35e58d}.status-pill.offline i{background:#ff5b68}.primary-btn,.ghost-btn,.icon-btn{border:0;color:#fff;font-weight:800}.primary-btn{padding:11px 17px;border-radius:12px;background:linear-gradient(135deg,var(--pink),#b72fff);box-shadow:0 10px 26px rgba(255,35,113,.24)}.primary-btn:hover{transform:translateY(-1px);filter:brightness(1.08)}.primary-btn:disabled{cursor:not-allowed;opacity:.55;transform:none}.ghost-btn{padding:10px 14px;border-radius:12px;border:1px solid var(--line);background:rgba(255,255,255,.05)}.layout{width:min(1420px,calc(100% - 36px));margin:28px auto 48px;display:grid;grid-template-columns:minmax(0,1.55fr) minmax(340px,.72fr);gap:22px}.glass{border:1px solid var(--line);background:linear-gradient(145deg,rgba(38,20,40,.78),rgba(16,10,19,.86));box-shadow:var(--shadow);backdrop-filter:blur(20px)}.game-panel,.ranking-panel{border-radius:28px}.game-panel{padding:clamp(22px,3.4vw,44px);min-height:calc(100vh - 138px);display:flex;flex-direction:column}.game-heading{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}.eyebrow{margin:0 0 9px;color:#ff6fa4;font-size:11px;font-weight:900;letter-spacing:.2em}.game-heading h1{margin:0;font-family:"Black Han Sans";font-weight:400;font-size:clamp(32px,4.2vw,62px);line-height:1.07;letter-spacing:-.03em}.game-heading em{font-style:normal;color:transparent;background:linear-gradient(90deg,#ff4d89,#b457ff,#51ddff);background-clip:text}.session-card{min-width:118px;text-align:right;padding:14px 16px;border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.04)}.session-card span{display:block;color:var(--muted);font-size:11px}.session-card strong{font-size:27px}.score-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:22px 0 4px}.score-strip div{padding:14px 18px;border-radius:17px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.07)}.score-strip span{display:block;font-size:11px;color:var(--muted)}.score-strip strong{font-size:25px}.click-stage{position:relative;min-height:430px;flex:1;display:grid;place-items:center;outline:none;isolation:isolate;user-select:none;-webkit-user-select:none;touch-action:manipulation}.click-stage:focus-visible{box-shadow:inset 0 0 0 2px var(--cyan);border-radius:24px}.click-stage img{position:relative;z-index:3;width:min(65%,560px);max-height:56vh;object-fit:contain;filter:drop-shadow(0 26px 38px rgba(0,0,0,.48));transition:transform 80ms ease,filter 80ms ease;pointer-events:none}.click-stage.pressed img{transform:scale(.96) translateY(5px);filter:drop-shadow(0 18px 30px rgba(255,22,93,.26))}.pulse-ring{position:absolute;width:min(58vw,570px);aspect-ratio:1;border-radius:50%;border:1px solid rgba(255,64,133,.22);z-index:0}.ring-a{box-shadow:inset 0 0 80px rgba(255,31,111,.11),0 0 70px rgba(255,31,111,.1)}.ring-b{width:min(45vw,440px);border-color:rgba(151,64,255,.24);animation:pulse 2.6s infinite}@keyframes pulse{50%{transform:scale(1.06);opacity:.45}}.tap-guide{position:absolute;z-index:4;bottom:14px;left:50%;transform:translateX(-50%);text-align:center;pointer-events:none}.tap-guide span{font-weight:900;letter-spacing:.28em;color:rgba(255,255,255,.82)}.tap-guide small{display:block;color:var(--muted);margin-top:3px}.play-hint{text-align:center;color:var(--muted);font-size:12px;margin:6px 0 0}.click-pop{position:absolute;z-index:10;font-family:"Black Han Sans";font-size:26px;color:#fff;text-shadow:0 0 18px var(--pink);animation:popUp .65s ease-out forwards;pointer-events:none}@keyframes popUp{0%{opacity:0;transform:translate(-50%,-10%) scale(.55)}25%{opacity:1}100%{opacity:0;transform:translate(-50%,-150%) scale(1.25)}}.ranking-panel{padding:25px;align-self:start;position:sticky;top:106px;max-height:calc(100vh - 132px);display:flex;flex-direction:column}.panel-head{display:flex;align-items:center;justify-content:space-between}.panel-head h2{margin:0;font-size:24px}.icon-btn{width:40px;height:40px;border-radius:12px;border:1px solid var(--line);background:rgba(255,255,255,.05);font-size:21px}.podium{height:210px;display:flex;align-items:flex-end;justify-content:center;gap:7px;padding:20px 0 15px}.podium-item{width:31%;min-width:0;text-align:center;border:1px solid var(--line);background:rgba(255,255,255,.04);border-radius:18px 18px 9px 9px;padding:12px 7px;position:relative}.podium-item.first{height:178px;background:linear-gradient(180deg,rgba(255,208,85,.14),rgba(255,255,255,.04))}.podium-item.second{height:143px}.podium-item.third{height:125px}.avatar{width:43px;height:43px;border-radius:50%;display:grid;place-items:center;margin:0 auto 8px;font-weight:900;background:linear-gradient(145deg,#ff4d89,#673aff)}.first .avatar{width:55px;height:55px;background:linear-gradient(145deg,#ffe277,#ff7f32)}.podium-item strong,.podium-item small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.podium-item strong{font-size:12px}.podium-item small{font-size:11px;color:var(--gold);margin-top:3px}.medal{position:absolute;top:8px;left:9px;color:var(--muted);font-weight:900}.crown{display:block;color:var(--gold);font-size:24px;height:28px}.rank-list-wrap{min-height:0;display:flex;flex-direction:column}.rank-labels{display:flex;justify-content:space-between;color:var(--muted);font-size:10px;border-bottom:1px solid var(--line);padding:0 8px 9px}.rank-list{padding:0;margin:0;list-style:none;overflow:auto;max-height:295px}.rank-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 8px;border-bottom:1px solid rgba(255,255,255,.055)}.rank-row.me{background:rgba(255,47,120,.085)}.rank-player{display:flex;align-items:center;gap:9px;min-width:0}.rank-number{width:21px;color:var(--muted);font-weight:900;font-size:12px}.mini-avatar{width:32px;height:32px;flex:0 0 auto;border-radius:10px;display:grid;place-items:center;font-weight:900;background:linear-gradient(145deg,rgba(255,47,120,.8),rgba(137,56,255,.8))}.rank-name{font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rank-score{font-size:12px;font-weight:900;color:#ff91b8}.ranking-note{text-align:center;color:var(--muted);font-size:10px;margin-top:13px}.modal{position:fixed;inset:0;z-index:50;display:none;align-items:center;justify-content:center;padding:20px}.modal.open{display:flex}.modal-backdrop{position:absolute;inset:0;background:rgba(3,2,4,.78);backdrop-filter:blur(9px)}.modal-card{position:relative;width:min(440px,100%);padding:31px;border:1px solid var(--line);border-radius:25px;background:#19101d;box-shadow:var(--shadow)}.modal-card.wide{width:min(690px,100%)}.modal-card h2{margin:0;font-size:28px}.modal-copy{color:var(--muted);font-size:13px;line-height:1.65}.modal-close{position:absolute;right:16px;top:13px;border:0;background:transparent;color:var(--muted);font-size:30px}.tab-switch{display:grid;grid-template-columns:1fr 1fr;background:rgba(255,255,255,.05);padding:4px;border-radius:12px;margin:20px 0}.tab-switch button{border:0;background:transparent;color:var(--muted);padding:10px;border-radius:9px;font-weight:800}.tab-switch button.active{background:rgba(255,255,255,.1);color:#fff}.field{display:block;margin:13px 0}.field span{display:block;font-size:11px;color:var(--muted);margin-bottom:6px}.field input{width:100%;padding:13px 14px;border:1px solid var(--line);border-radius:12px;background:#100b12;color:#fff;outline:none}.field input:focus{border-color:var(--pink);box-shadow:0 0 0 3px rgba(255,47,120,.1)}.full{width:100%;margin-top:8px;padding:13px}.form-message{min-height:20px;color:#ff91b8;font-size:12px;text-align:center}.upload-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin:22px 0}.upload-box{border:1px dashed rgba(255,255,255,.22);border-radius:18px;padding:15px;text-align:center;cursor:pointer;background:rgba(255,255,255,.025)}.upload-box:hover{border-color:var(--pink)}.upload-box span{display:block;font-size:12px;color:var(--muted);margin-bottom:10px}.upload-box img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:13px;background:#0c080e}.upload-box input{display:none}.upload-box b{display:inline-block;margin-top:10px;font-size:12px}.toast{position:fixed;z-index:80;left:50%;bottom:28px;transform:translate(-50%,25px);padding:12px 18px;border:1px solid var(--line);border-radius:13px;background:rgba(20,12,23,.94);box-shadow:var(--shadow);opacity:0;pointer-events:none;transition:.22s}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:980px){.layout{grid-template-columns:1fr}.ranking-panel{position:static;max-height:none}.game-panel{min-height:auto}.rank-list{max-height:360px}.click-stage{min-height:440px}}
@media(max-width:620px){.topbar{height:70px;padding:0 14px}.brand small,.status-pill span{display:none}.status-pill{padding:10px}.top-actions{gap:6px}.primary-btn,.ghost-btn{padding:9px 11px;font-size:12px}.layout{width:min(100% - 20px,1420px);margin:12px auto 30px;gap:12px}.game-panel,.ranking-panel{border-radius:20px}.game-panel{padding:19px 14px}.game-heading{display:block}.session-card{position:absolute;right:26px;top:106px;min-width:88px;padding:10px}.game-heading h1{font-size:34px;max-width:280px}.score-strip{margin-top:24px}.score-strip div{padding:11px 9px}.score-strip strong{font-size:19px}.score-strip span{font-size:9px}.click-stage{min-height:380px}.click-stage img{width:min(88%,430px);max-height:none}.pulse-ring{width:92vw}.ring-b{width:72vw}.tap-guide{bottom:3px}.modal-card{padding:27px 19px}.upload-grid{grid-template-columns:1fr}.podium{height:195px}.ranking-panel{padding:20px}}
